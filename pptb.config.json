{
    "invocation": {
        "version": "1.0.0",
        "capabilities": [
            "dataverse-search"
        ],
        "prefill": {
            "type": "object",
            "properties": {
                "searchTerm": {
                    "type": "string",
                    "description": "Required search text to run in headless execution. Example values: contoso, account, Jane."
                },
                "scope": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "records",
                            "metadata",
                            "solutionComponents"
                        ]
                    },
                    "default": [
                        "records"
                    ]
                },
                "entities": {
                    "type": "string",
                    "description": "Optional entity filter. Supports logical names or display names, with single or comma-separated values (account,contact or Account,Contact)."
                },
                "lookupField": {
                    "type": "string",
                    "description": "Optional lookup field to search by related record primary name"
                },
                "lookupTargetEntity": {
                    "type": "string",
                    "description": "Optional target entity for lookup-field searches"
                },
                "lookupTargetPrimaryNameField": {
                    "type": "string",
                    "description": "Optional target primary-name field for lookup-field searches"
                },
                "maxResults": {
                    "type": "number",
                    "default": 50
                },
                "matchCase": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "returnTopic": {
            "type": "object",
            "properties": {
                "totalMatches": {
                    "type": "number"
                },
                "results": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string"
                            },
                            "entityName": {
                                "type": "string"
                            },
                            "tabTitle": {
                                "type": "string"
                            },
                            "totalCount": {
                                "type": "number"
                            },
                            "records": {
                                "type": "array",
                                "items": {
                                    "type": "object"
                                }
                            },
                            "error": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "agents": {
        "version": "1.0.0",
        "invokable": true,
        "modes": [
            "one-way",
            "two-way"
        ],
        "defaultMode": "two-way",
        "timeoutMS": 180000,
        "headless": true,
        "executionModes": [
            "windowed",
            "headless"
        ],
        "defaultExecutionMode": "headless",
        "headlessEntry": "dist/headless.cjs"
    }
}